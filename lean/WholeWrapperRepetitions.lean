import WholeWrapperTrialTrace

/-! Actual finite repetition blocks, preserving
all completed trial records and aggregate calls without storing any history. -/
namespace QecReliability.OracleCost.WholeWrapperCandidate

def CoefficientContextEq (s anchor : Config) : Prop :=
  s.good=anchor.good ∧ s.coefficient=anchor.coefficient

/-- Scratch reset for equality proofs only. Current trial fields are forgotten;
code, completed trials, coefficient aggregate, both raw tables and all repair
/output data remain literal. Canonical erased pc agrees with other frames. -/
def repetitionFrame (s : Config) : Config :=
  trialFrame { s with repetition := 0,nonempty := false,trialCalls := 0,cellsRev := [] }

def repetitionEntries (q B : ℕ) (ext : External) (anchor : Config) (reps : List ℕ) : List Entry :=
  reps.map (operationalTrial q B ext anchor)

def repetitionCalls (q B : ℕ) (ext : External) (anchor : Config) (reps : List ℕ) : ℕ :=
  ((repetitionEntries q B ext anchor reps).map Prod.snd).sum

def repetitionTime (q B : ℕ) (ext : External) (anchor : Config) (reps : List ℕ) : ℕ :=
  (reps.map (operationalTrialTime q B ext anchor)).sum

theorem operationalTrial_context {s anchor : Config} (h : CoefficientContextEq s anchor)
    (q B : ℕ) (ext : External) (rep : ℕ) :
    operationalTrial q B ext s rep=operationalTrial q B ext anchor rep := by
  rcases h with ⟨hg,hj⟩
  have ho : ∀ j, cellOracle ext (trialAnchor s rep) j =
      cellOracle ext (trialAnchor anchor rep) j := by
    intro j
    funext pre
    simp [cellOracle,cellKey,trialAnchor,hg,hj]
  simp [operationalTrial,baseKey,cellEntries,cellCallSum,cellResult,ho,hg,hj]

theorem operationalTrialTime_context {s anchor : Config} (h : CoefficientContextEq s anchor)
    (q B : ℕ) (ext : External) (rep : ℕ) :
    operationalTrialTime q B ext s rep=operationalTrialTime q B ext anchor rep := by
  rcases h with ⟨hg,hj⟩
  have ho : ∀ j, cellOracle ext (trialAnchor s rep) j =
      cellOracle ext (trialAnchor anchor rep) j := by
    intro j
    funext pre
    simp [cellOracle,cellKey,trialAnchor,hg,hj]
  simp [operationalTrialTime,baseKey,cellTimeSum,cellResult,ho,hg,hj]

/-- Complete actual repetition block. No list/source-record invariant is a
premise; the exact reverse list and aggregate are generated by the induction. -/
theorem repetitions_trace (q r B m : ℕ) (shape : Bool) (ext : External)
    (anchor : Config) (reps : List ℕ) (s : Config) (rest : List Opcode)
    (hpc : s.pc=.fetch) (hcode : s.code=reps.flatMap (trialCode q)++rest)
    (hcontext : CoefficientContextEq s anchor) :
    ∃ t totals events,
      Trace q r B m shape ext s totals events t ∧
      t.pc=.fetch ∧ t.code=rest ∧
      t.trialsRev=(repetitionEntries q B ext anchor reps).reverse++s.trialsRev ∧
      t.coefficientCalls=s.coefficientCalls+repetitionCalls q B ext anchor reps ∧
      repetitionFrame t=repetitionFrame { s with
        code := rest,
        trialsRev := (repetitionEntries q B ext anchor reps).reverse++s.trialsRev,
        coefficientCalls := s.coefficientCalls+repetitionCalls q B ext anchor reps } ∧
      totals.calls=repetitionCalls q B ext anchor reps ∧
      totals.oracleTime=repetitionTime q B ext anchor reps ∧ totals.endpointTime=0 ∧
      totals.dispatches≤8*repetitionCalls q B ext anchor reps+(5*q+20)*reps.length := by
  induction reps generalizing s with
  | nil =>
      have hc : s.code=rest := by simpa using hcode
      refine ⟨s,{},[],Trace.nil s,hpc,hc,?_,?_,?_,rfl,rfl,rfl,by simp⟩
      · simp [repetitionEntries]
      · simp [repetitionCalls,repetitionEntries]
      · simp [repetitionFrame,repetitionEntries,repetitionCalls,hc]
  | cons rep reps ih =>
      let tailCode := reps.flatMap (trialCode q)++rest
      let pair := operationalTrial q B ext anchor rep
      obtain ⟨mid,htotal,hevents,hhead,hmidpc,hmidcode,hmidtrials,hmidcalls,hmidframe,
          hheadcalls,hheadtime,hheadendpoint,hheadsteps,_⟩ :=
        trial_code_trace q r B m shape ext s rep tailCode hpc
          (by simpa [tailCode,List.flatMap_cons,List.append_assoc] using hcode)
      have hp := operationalTrial_context hcontext q B ext rep
      have htime := operationalTrialTime_context hcontext q B ext rep
      have hmidtrials' : mid.trialsRev=pair::s.trialsRev := by simpa [pair,hp] using hmidtrials
      have hmidcalls' : mid.coefficientCalls=s.coefficientCalls+pair.2 := by
        simpa [pair,hp] using hmidcalls
      have hf : repetitionFrame mid=repetitionFrame
          { s with
            code := tailCode,trialsRev := pair::s.trialsRev,
            coefficientCalls := s.coefficientCalls+pair.2 } := by
        have hh := congrArg (fun a : Config =>
          { a with repetition := 0,nonempty := false,trialCalls := 0,cellsRev := [] }) hmidframe
        simpa [repetitionFrame,trialFrame,selectionFrame,batchFrame,prefixFrame,
          baseAfter,pair,hp] using hh
      have hmidcontext : CoefficientContextEq mid anchor := by
        have hg := congrArg Config.good hf
        have hj := congrArg Config.coefficient hf
        exact ⟨(show mid.good=s.good from by
            simpa [repetitionFrame,trialFrame,selectionFrame,batchFrame,prefixFrame] using hg).trans hcontext.1,
          (show mid.coefficient=s.coefficient from by
            simpa [repetitionFrame,trialFrame,selectionFrame,batchFrame,prefixFrame] using hj).trans hcontext.2⟩
      obtain ⟨t,ttotal,tevents,ht,htpc,htcode,httrials,htcalls,htframe,
          htailcalls,htailtime,htailendpoint,htailsteps⟩ :=
        ih mid hmidpc hmidcode hmidcontext
      refine ⟨t,Totals.append htotal ttotal,hevents++tevents,hhead.trans ht,
        htpc,htcode,?_,?_,?_,?_,?_,?_,?_⟩
      · simpa [repetitionEntries,List.reverse_cons,List.append_assoc,hmidtrials',pair] using httrials
      · simpa [repetitionCalls,repetitionEntries,hmidcalls',pair,Nat.add_assoc] using htcalls
      · have hh := congrArg (fun a : Config =>
          { a with
            code := rest,
            trialsRev := (repetitionEntries q B ext anchor reps).reverse++a.trialsRev,
            coefficientCalls := a.coefficientCalls+repetitionCalls q B ext anchor reps }) hf
        have hh' : repetitionFrame { mid with
            code := rest,
            trialsRev := (repetitionEntries q B ext anchor reps).reverse++mid.trialsRev,
            coefficientCalls := mid.coefficientCalls+repetitionCalls q B ext anchor reps }=
            repetitionFrame { s with
              code := rest,
              trialsRev := (repetitionEntries q B ext anchor (rep::reps)).reverse++s.trialsRev,
              coefficientCalls := s.coefficientCalls+repetitionCalls q B ext anchor (rep::reps) } := by
          simpa [repetitionFrame,trialFrame,selectionFrame,batchFrame,prefixFrame,
            repetitionEntries,repetitionCalls,pair,List.reverse_cons,List.append_assoc,Nat.add_assoc] using hh
        exact htframe.trans hh'
      · simp [Totals.append,repetitionCalls,repetitionEntries,hheadcalls,htailcalls,hp]
      · simp [Totals.append,repetitionTime,hheadtime,htailtime,htime]
      · simp [Totals.append,hheadendpoint,htailendpoint]
      · simp only [Totals.append]
        rw [hp] at hheadsteps
        simp only [repetitionCalls,repetitionEntries,List.map_cons,List.sum_cons,List.length_cons]
        change htotal.dispatches+ttotal.dispatches≤
          8*(pair.2+repetitionCalls q B ext anchor reps)+(5*q+20)*(reps.length+1)
        change htotal.dispatches≤8*pair.2+5*q+20 at hheadsteps
        nlinarith

end QecReliability.OracleCost.WholeWrapperCandidate
