/-- **The installed FL program.** -/
def prog (base den density : ℕ) (E : ℕ × ℕ × ℕ) (pg : ℕ → ProgP) (nb : ℕ → ℕ → ℕ → ℕ) : Program :=
  Trans.Query.queryProg ++ seg base den density E pg nb

set_option maxRecDepth 4096 in
/-- Number of bodies: `95 + 191`. -/
theorem seg_length (base den density : ℕ) (E : ℕ × ℕ × ℕ) (pg : ℕ → ProgP) (nb : ℕ → ℕ → ℕ → ℕ) :
    (seg base den density E pg nb).length = 191 := rfl

